<%@ page pageEncoding="UTF-8" %>
<%-- expects: activeTab (String: home|accounts|transfer|mypage) set via <c:set> before include --%>
<div class="bk-tabbar">
    <a class="bk-tab ${activeTab == 'home' ? 'active' : ''}" href="${pageContext.request.contextPath}/">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M3 10.5 12 3l9 7.5"></path><path d="M5 9v12h14V9"></path></svg>홈</a>
    <a class="bk-tab ${activeTab == 'accounts' ? 'active' : ''}" href="${pageContext.request.contextPath}/accounts">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><rect x="3" y="5" width="18" height="15"></rect><path d="M3 10h18"></path><path d="M15 15h2"></path></svg>계좌</a>
    <a class="bk-tab ${activeTab == 'transfer' ? 'active' : ''}" href="${pageContext.request.contextPath}/transactions/transfer">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M8 3 4 7l4 4"></path><path d="M4 7h16"></path><path d="m16 21 4-4-4-4"></path><path d="M20 17H4"></path></svg>이체</a>
    <a class="bk-tab ${activeTab == 'mypage' ? 'active' : ''}" href="${pageContext.request.contextPath}/members/mypage">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><circle cx="12" cy="8" r="4"></circle><path d="M4 21a8 8 0 0 1 16 0"></path></svg>마이</a>
</div>
